<?xml version="1.0"?>
<gdml>
  <solids>
    <box name="WorldBox" x="200" y="200" z="200" lunit="cm"/>
    <box name="LArBox"   x="100" y="100" z="100" lunit="cm"/>
  </solids>

  <structure>
    <volume name="LAr_vol">
      <materialref ref="G4_lAr"/>
      <solidref ref="LArBox"/>
    </volume>

    <volume name="World">
      <materialref ref="G4_AIR"/>
      <solidref ref="WorldBox"/>
      <physvol>
        <volumeref ref="LAr_vol"/>
        <position x="0" y="0" z="0"/>
      </physvol>
    </volume>
  </structure>

  <setup name="Default" version="1.0">
    <world ref="World"/>
  </setup>
</gdml>
